#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_GOOGLE_include_directive : require

#include "random.glsl"

layout(set = 0, binding = 0) uniform accelerationStructureEXT topLevelAS;

// Raw current frame output for SVGF
layout(set = 0, binding = 1, rgba16f) uniform image2D inputImage;

// G-buffer
layout(set = 0, binding = 11, rgba16f) writeonly uniform image2D gbufferNormalImage;
layout(set = 0, binding = 12, rgba8)   writeonly uniform image2D gbufferAlbedoImage;
layout(set = 0, binding = 13, rg16f)   writeonly uniform image2D gbufferVelocityImage;

layout(std140, set = 0, binding = 2) uniform UniformData
{
    mat4 model;
    mat4 view;
    mat4 proj;
    mat4 prevView;
    mat4 prevProj;
    mat4 projUnjittered;
    mat4 prevProjUnjittered;
} ubo;

struct rayPayload
{
    vec3 hitColor;
    vec3 directLight;
    vec3 rayOrigin;
    vec3 rayDir;
    bool hit;
    bool isEmissive;
    vec3 primaryNormal;
    vec3 primaryAlbedo;
    float hitDistance;
    uint bounce;
};

layout(push_constant) uniform PushConstants
{
    uint frameIndex;
    uint missColour;
    uint stepSize;
} pc;

layout(location = 0) rayPayloadEXT rayPayload payload;

void main()
{
    ivec2 pixelCoord = ivec2(gl_LaunchIDEXT.xy);
    vec2 resolution = vec2(gl_LaunchSizeEXT.xy);

    uint pixelID = gl_LaunchIDEXT.x + gl_LaunchIDEXT.y * gl_LaunchSizeEXT.x;
    uint seed = initPRNG(pixelID, pc.frameIndex);

    vec2 pureUV = (vec2(pixelCoord) + 0.5) / resolution;

    vec2 subpixelJitter = vec2(randomFloat(seed) - 0.5, randomFloat(seed) - 0.5);
    vec2 pixelCenter = vec2(pixelCoord) + vec2(0.5) + subpixelJitter;
    vec2 rayUV = pixelCenter / resolution;
    vec2 ndc = rayUV * 2.0 - 1.0;

    mat4 invView = inverse(ubo.view);
    mat4 invProj = inverse(ubo.proj);

    vec4 origin = invView * vec4(0.0, 0.0, 0.0, 1.0);
    vec4 target = invProj * vec4(ndc.x, ndc.y, 1.0, 1.0);
    target /= target.w;

    vec4 worldDir = invView * vec4(target.xyz, 0.0);
    vec3 rayOrigin = origin.xyz;
    vec3 rayDirection = normalize(worldDir.xyz);

    if (abs(rayDirection.x) < 1e-7) rayDirection.x = 1e-7;
    if (abs(rayDirection.y) < 1e-7) rayDirection.y = 1e-7;
    if (abs(rayDirection.z) < 1e-7) rayDirection.z = 1e-7;

    vec3 currentFrameColor = vec3(0.0);
    vec3 throughput = vec3(1.0);
    const int MAX_BOUNCES = 5;
    vec2 velocity = vec2(0.0);

    for (int bounce = 0; bounce < MAX_BOUNCES; ++bounce)
    {
        payload.hit = false;
        payload.isEmissive = false;
        payload.hitColor = vec3(0.0);
        payload.directLight = vec3(0.0);  
        payload.primaryNormal = vec3(0.0);
        payload.primaryAlbedo = vec3(0.0);
        payload.bounce = uint(bounce);

        traceRayEXT(topLevelAS, gl_RayFlagsNoneEXT, 0xFF, 0, 0, 0, rayOrigin, 0.001, rayDirection, 10000.0, 0);

        if (bounce == 0)
        {
            if (payload.hit)
            {
                vec3 normColor = payload.primaryNormal * 0.5 + 0.5;

                vec3 worldPos = rayOrigin + rayDirection * payload.hitDistance;
                vec4 prevClip = ubo.prevProjUnjittered * ubo.prevView * vec4(worldPos, 1.0);

                if (prevClip.w > 0.0001)
                {
                    vec2 prevNDC = prevClip.xy / prevClip.w;
                    vec2 prevProjectedUV = prevNDC * 0.5 + 0.5;
                    velocity = (pureUV - prevProjectedUV) * resolution;
                }
                else
                {
                    velocity = vec2(0.0);
                }

                imageStore(gbufferNormalImage, pixelCoord, vec4(normColor, payload.hitDistance));
                imageStore(gbufferAlbedoImage, pixelCoord, vec4(payload.primaryAlbedo, 1.0));
                imageStore(gbufferVelocityImage, pixelCoord, vec4(velocity, 0.0, 0.0));
            }
            else
            {
                velocity = vec2(0.0);
                imageStore(gbufferNormalImage, pixelCoord, vec4(0.0, 0.0, 0.0, 10000.0));
                imageStore(gbufferAlbedoImage, pixelCoord, vec4(0.0, 0.0, 0.0, 0.0));
                imageStore(gbufferVelocityImage, pixelCoord, vec4(0.0, 0.0, 0.0, 0.0));
            }
        }

        // add the direct-light (NEE) contribution from this bounce's hit point
        currentFrameColor += throughput * payload.directLight;

        // after accumulating, before the next bounce or final store:
        float lum = dot(currentFrameColor, vec3(0.2126, 0.7152, 0.0722));
        const float FIREFLY_CLAMP = 50.0; // tune to your light intensity
        if (lum > FIREFLY_CLAMP) currentFrameColor *= FIREFLY_CLAMP / lum;

        if (!payload.hit)
        {
            currentFrameColor += throughput * payload.hitColor;
            break;
        }

        if (payload.isEmissive)
        {
            currentFrameColor += throughput * payload.hitColor;
            break;
        }

        throughput *= payload.hitColor;

        if (max(throughput.r, max(throughput.g, throughput.b)) < 0.001)
        {
            break;
        }

        rayOrigin = payload.rayOrigin;
        rayDirection = payload.rayDir;
    }

    imageStore(inputImage, pixelCoord, vec4(currentFrameColor, 1.0));
}