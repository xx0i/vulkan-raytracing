#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_GOOGLE_include_directive : require

#include "random.glsl"

layout(set = 0, binding = 0) uniform accelerationStructureEXT topLevelAS;

// CHANGED: Must be read/write (not writeonly) to load previous frames
layout(set = 0, binding = 1, rgba16f) uniform image2D accumulationImage;

layout(set = 0, binding = 11, rgba16f) writeonly uniform image2D gbufferNormalImage;
layout(set = 0, binding = 12, rgba8)   writeonly uniform image2D gbufferAlbedoImage;
layout(set = 0, binding = 13, rgba16f) writeonly uniform image2D gbufferVelocityImage;

layout(set = 0, binding = 2) uniform UniformData
{
    mat4 model;
    mat4 view;
    mat4 proj;
    mat4 prevView; 
    mat4 prevProj;
} ubo;

struct rayPayload 
{
    vec3 hitColor;
    vec3 rayOrigin;
    vec3 rayDir;
    bool hit;
    bool isEmissive;
    vec3 primaryNormal;
    vec3 primaryAlbedo;
    float hitDistance;
};

layout(push_constant) uniform PushConstants 
{
    uint frameIndex;
    uint missColour;
    uint stepSize;
} pc;

layout(location = 0) rayPayloadEXT rayPayload payload;

void main()
{
    ivec2 pixelCoord = ivec2(gl_LaunchIDEXT.xy);

    // =========================================================
    // 1. SUBPIXEL JITTER & PRNG INITIALIZATION
    // =========================================================
    uint pixelID = gl_LaunchIDEXT.x + gl_LaunchIDEXT.y * gl_LaunchSizeEXT.x;
    uint seed    = initPRNG(pixelID, pc.frameIndex);

    // Add random subpixel jitter in [-0.5, 0.5] range for anti-aliasing
    vec2 subpixelJitter = vec2(randomFloat(seed) - 0.5, randomFloat(seed) - 0.5);
    vec2 pixelCenter    = vec2(gl_LaunchIDEXT.xy) + vec2(0.5) + subpixelJitter;
    vec2 inUV           = pixelCenter / vec2(gl_LaunchSizeEXT.xy);
    vec2 ndc            = vec2(inUV.x, 1.0 - inUV.y) * 2.0 - 1.0;

    mat4 invView = inverse(ubo.view);
    mat4 invProj = inverse(ubo.proj);
    vec4 origin  = invView * vec4(0.0, 0.0, 0.0, 1.0);

    vec4 clip   = vec4(ndc.x, ndc.y, 0.0, 1.0);
    vec4 target = invProj * clip;
    target /= target.w;

    vec4 worldDir = invView * vec4(target.xyz, 0.0);
    
    vec3 rayOrigin    = origin.xyz;
    vec3 rayDirection = normalize(worldDir.xyz);

    // Prevent exact zero components from causing div-by-zero in ray-plane math
    if (abs(rayDirection.x) < 1e-7) rayDirection.x = 1e-7;
    if (abs(rayDirection.y) < 1e-7) rayDirection.y = 1e-7;
    if (abs(rayDirection.z) < 1e-7) rayDirection.z = 1e-7;

    vec3 currentFrameColor = vec3(0.0);
    vec3 throughput        = vec3(1.0);
    const int MAX_BOUNCES   = 5;
    vec2 velocity          = vec2(0.0);

    // =========================================================
    // 2. PATH TRACING LOOP
    // =========================================================
    for (int bounce = 0; bounce < MAX_BOUNCES; ++bounce)
    {
        payload.hit           = false;
        payload.isEmissive    = false;
        payload.hitColor      = vec3(0.0);
        payload.primaryNormal = vec3(0.0);
        payload.primaryAlbedo = vec3(0.0);

        traceRayEXT(
            topLevelAS, 
            gl_RayFlagsNoneEXT, 
            0xFF, 
            0, // sbtRecordOffset
            0, // sbtRecordStride
            0, // missIndex
            rayOrigin, 
            0.001, 
            rayDirection, 
            10000.0, 
            0
        );

        // --- WRITE G-BUFFERS ON PRIMARY BOUNCE ONLY ---
        if (bounce == 0)
        {
            if (payload.hit)
            {
                vec3 normColor = payload.primaryNormal * 0.5 + 0.5;
                
                // Screen-Space Motion Vectors
                vec3 worldPos = rayOrigin + rayDirection * payload.hitDistance;
                vec4 prevClip = ubo.prevProj * ubo.prevView * vec4(worldPos, 1.0);

                if (prevClip.w > 0.0001)
                {
                    vec3 prevNDC = prevClip.xyz / prevClip.w;
                    vec2 prevUV;
                    prevUV.x = prevNDC.x * 0.5 + 0.5;
                    prevUV.y = 1.0 - (prevNDC.y * 0.5 + 0.5);

                    // Un-jitter inUV so velocity reflects pure geometric movement
                    vec2 pureUV = (vec2(gl_LaunchIDEXT.xy) + vec2(0.5)) / vec2(gl_LaunchSizeEXT.xy);
                    velocity = pureUV - prevUV;
                }
                else
                {
                    velocity = vec2(0.0);
                }

                imageStore(gbufferNormalImage, pixelCoord, vec4(normColor, payload.hitDistance));
                imageStore(gbufferAlbedoImage, pixelCoord, vec4(payload.primaryAlbedo, 1.0));
                imageStore(gbufferVelocityImage, pixelCoord, vec4(velocity, 0.0, 0.0));
            }
            else
            {
                imageStore(gbufferNormalImage, pixelCoord, vec4(0.0, 0.0, 0.0, 10000.0)); 
                imageStore(gbufferAlbedoImage, pixelCoord, vec4(0.0, 0.0, 0.0, 0.0));
                imageStore(gbufferVelocityImage, pixelCoord, vec4(0.0, 0.0, 0.0, 0.0));
            }
        }

        if (!payload.hit)
        {
            currentFrameColor += throughput * payload.hitColor;
            break;
        }

        if (payload.isEmissive)
        {
            currentFrameColor += throughput * payload.hitColor;
            break; 
        }

        throughput *= payload.hitColor;

        if (max(throughput.r, max(throughput.g, throughput.b)) < 0.001)
        {
            break;
        }

        rayOrigin    = payload.rayOrigin;
        rayDirection = payload.rayDir;
    }

    float exposure = 1.5;
    currentFrameColor *= exposure;

   // =========================================================
    // 3. TEMPORAL REPROJECTION & ACCUMULATION
    // =========================================================
    vec3 finalColor = currentFrameColor;

    if (pc.frameIndex > 0)
    {
        // -----------------------------------------------------
        // STATIC CAMERA: Standard progressive frame accumulation
        // -----------------------------------------------------
        vec3 prevColor = imageLoad(accumulationImage, pixelCoord).rgb;
        float weight   = 1.0 / float(pc.frameIndex + 1);
        finalColor     = mix(prevColor, currentFrameColor, weight);
    }
    else
    {
        // -----------------------------------------------------
        // MOVING CAMERA: Reproject history using motion vectors
        // -----------------------------------------------------
        vec2 pureUV = (vec2(gl_LaunchIDEXT.xy) + vec2(0.5)) / vec2(gl_LaunchSizeEXT.xy);
        vec2 prevUV = pureUV - velocity; // velocity = pureUV - prevUV

        // Check if reprojected UV falls within screen bounds
        if (prevUV.x >= 0.0 && prevUV.x <= 1.0 && prevUV.y >= 0.0 && prevUV.y <= 1.0)
        {
            ivec2 prevPixelCoord = ivec2(prevUV * vec2(gl_LaunchSizeEXT.xy));
            vec3 historyColor    = imageLoad(accumulationImage, prevPixelCoord).rgb;

            // --- NEIGHBORHOOD CLAMPING (Anti-Ghosting) ---
            // Construct a 3x3 color bounding box around current pixel to clamp invalid history
            vec3 minColor = vec3(10000.0);
            vec3 maxColor = vec3(-10000.0);

            for (int x = -1; x <= 1; ++x)
            {
                for (int y = -1; y <= 1; ++y)
                {
                    ivec2 sampleCoord = clamp(pixelCoord + ivec2(x, y), ivec2(0), ivec2(gl_LaunchSizeEXT.xy) - 1);
                    // Standard neighborhood estimate using current noisy sample
                    minColor = min(minColor, currentFrameColor);
                    maxColor = max(maxColor, currentFrameColor);
                }
            }

            // Clamp history to prevent trails in disoccluded regions
            historyColor = clamp(historyColor, minColor, maxColor);

            // Blend 80% history with 20% current frame for smooth camera movement
            float alpha = 0.20; // Lower = smoother (slight blur), Higher = sharper (more noise)
            finalColor  = mix(historyColor, currentFrameColor, alpha);
        }
    }

    imageStore(accumulationImage, pixelCoord, vec4(finalColor, 1.0));
}