#version 460

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

// Layout Bindings
layout(set = 0, binding = 0, rgba16f) writeonly uniform image2D outputImage;
layout(set = 0, binding = 1, rgba16f) readonly  uniform image2D inputImage;

layout(set = 0, binding = 2)          uniform sampler2D accumulationTexture;
layout(set = 0, binding = 3, rgba16f) uniform image2D accumulationImage;

layout(set = 0, binding = 4, rgba16f) readonly uniform image2D gbufferNormalImage;
layout(set = 0, binding = 5, rgba8)   readonly uniform image2D gbufferAlbedoImage;
layout(set = 0, binding = 6, rg16f)   readonly uniform image2D gbufferVelocityImage;

layout(set = 0, binding = 7)          uniform sampler2D prevNormalDepthTexture;
layout(set = 0, binding = 8)          uniform sampler2D prevMomentsTexture;
layout(set = 0, binding = 9, rgba16f) uniform image2D currentMomentsImage;

layout(push_constant) uniform PushConstants
{
    uint frameIndex;
    uint missColour;
    uint stepSize;     // 0 for Temporal pass; 1, 2, 4, 8... for À-Trous passes
    uint isFinalPass;  // 1 if this dispatch is the final À-Trous pass, 0 otherwise
    uint isTemporalPass;
} pc;

const float EPSILON = 1e-4;

// Perceptual log-space luminance conversion for both moments and spatial weighting
float getPerceptualLuminance(vec3 color)
{
    float rawLum = dot(color, vec3(0.2126, 0.7152, 0.0722));
    return log(1.0 + max(0.0, rawLum));
}

// Reinhard tonemap: x/(x+1). Slope is 1 near zero, so shadows/midtones stay
// close to their original linear brightness — only genuinely bright values
// (like the light) get compressed. Much gentler than ACES on the low end.
vec3 tonemapReinhard(vec3 x)
{
    return x / (x + vec3(1.0));
}

// Catmull-Rom history sampling — used for COLOR only. Its negative side-lobes
// can ring/overshoot on sharp discontinuities, which is fine (even desirable)
// for radiance, but must not be used for historyLength (see below).
vec4 sampleTextureCatmullRom(sampler2D tex, vec2 uv, vec2 texSize)
{
    vec2 samplePos = uv * texSize;
    vec2 tc = floor(samplePos - 0.5) + 0.5;

    vec2 f  = samplePos - tc;
    vec2 f2 = f * f;
    vec2 f3 = f2 * f;

    vec2 w0 = f2 - 0.5 * (f3 + f);
    vec2 w1 = 1.5 * f3 - 2.5 * f2 + 1.0;
    vec2 w2 = -1.5 * f3 + 2.0 * f2 + 0.5 * f;
    vec2 w3 = 0.5 * (f3 - f2);

    vec2 w12  = w1 + w2;
    vec2 tc12 = tc + w2 / max(w12, vec2(EPSILON));

    vec2 texelSize = 1.0 / texSize;

    vec2 tc0 = tc - 1.0;
    vec2 tc3 = tc + 2.0;

    vec4 color = vec4(0.0);

    color += texture(tex, vec2(tc12.x, tc0.y) * texelSize) * (w12.x * w0.y);
    color += texture(tex, vec2(tc0.x, tc12.y) * texelSize) * (w0.x * w12.y);
    color += texture(tex, vec2(tc12.x, tc12.y) * texelSize) * (w12.x * w12.y);
    color += texture(tex, vec2(tc3.x, tc12.y) * texelSize) * (w3.x * w12.y);
    color += texture(tex, vec2(tc12.x, tc3.y) * texelSize) * (w12.x * w3.y);

    return max(vec4(0.0), color);
}

void main()
{
    ivec2 pixelCoords = ivec2(gl_GlobalInvocationID.xy);
    ivec2 imageSize   = imageSize(outputImage);

    if (pixelCoords.x >= imageSize.x || pixelCoords.y >= imageSize.y) return;

    vec2 currentUV = (vec2(pixelCoords) + 0.5) / vec2(imageSize);

    // G-buffer Reads
    vec4 normalAndDepth = imageLoad(gbufferNormalImage, pixelCoords);
    vec3 centerNormal   = normalize(normalAndDepth.rgb * 2.0 - 1.0);
    float centerDepth   = normalAndDepth.a;

    vec3 centerAlbedo   = imageLoad(gbufferAlbedoImage, pixelCoords).rgb;
    centerAlbedo        = max(centerAlbedo, vec3(0.01));

    vec4 currentInputColor = imageLoad(inputImage, pixelCoords);

    // Demodulate raw radiance to pure irradiance inside Pass 0
    if (pc.isTemporalPass == 1)
    {
        currentInputColor.rgb /= centerAlbedo;
    }

    float filteredVariance = 0.0;
    float historyLength    = 0.0;

    // STEP 1: Temporal integration (Pass 0)
    if (pc.isTemporalPass == 1)
    {
        vec2 velocityPixels = imageLoad(gbufferVelocityImage, pixelCoords).xy;
        vec2 velocityUV     = velocityPixels / vec2(imageSize);
        vec2 prevUV         = currentUV - velocityUV;
        float motionVectorLen = length(velocityUV);

        vec4 prevAccum = vec4(0.0);

        // Suppress HDR outliers in moment calculation
        vec3 clampedInput = min(currentInputColor.rgb, vec3(16.0));
        float currentLum  = getPerceptualLuminance(clampedInput);

        vec2 currentMoments = vec2(currentLum, currentLum * currentLum);
        vec2 accumulatedMoments = currentMoments;

        bool insideScreen = prevUV.x >= 0.0 && prevUV.x <= 1.0 &&
                            prevUV.y >= 0.0 && prevUV.y <= 1.0;

        if (insideScreen)
        {
            // Color: Catmull-Rom (sharp reprojection, ringing near edges is acceptable here)
            prevAccum = sampleTextureCatmullRom(accumulationTexture, prevUV, vec2(imageSize));

            // historyLength: resample separately with plain bilinear — Catmull-Rom's
            // negative side-lobes can overshoot this value near any local discontinuity
            // (e.g. a hard-edged light), causing it to intermittently reset/spike even
            // when no real disocclusion occurred. Bilinear can't ring, so it's stable.
            float prevHistoryLength = texture(accumulationTexture, prevUV).a;
            prevAccum.a = prevHistoryLength;

            historyLength = min(prevAccum.a, 128.0);

            vec4 prevNormalDepth = texture(prevNormalDepthTexture, prevUV);
            vec3 prevNormal = normalize(prevNormalDepth.rgb * 2.0 - 1.0);
            float prevDepth = prevNormalDepth.a;

            // Depth gradient compensation for plane angles during motion
            ivec2 rightCoord = clamp(pixelCoords + ivec2(1, 0), ivec2(0), imageSize - ivec2(1));
            ivec2 topCoord   = clamp(pixelCoords + ivec2(0, 1), ivec2(0), imageSize - ivec2(1));

            float depthRight = imageLoad(gbufferNormalImage, rightCoord).a;
            float depthTop   = imageLoad(gbufferNormalImage, topCoord).a;

            float depthGrad      = max(abs(depthRight - centerDepth), abs(depthTop - centerDepth));
            float depthThreshold = 0.05 * centerDepth + depthGrad * 2.0 + EPSILON;

            bool depthDisoccluded  = abs(centerDepth - prevDepth) > depthThreshold;
            bool normalDisoccluded = dot(centerNormal, prevNormal) < 0.7;

            if (depthDisoccluded || normalDisoccluded)
            {
                historyLength = 0.0;
            }
            else
            {
                // 3x3 Neighborhood clamping window
                vec3 m1 = vec3(0.0);
                vec3 m2 = vec3(0.0);

                for (int x = -1; x <= 1; ++x)
                {
                    for (int y = -1; y <= 1; ++y)
                    {
                        ivec2 nc = clamp(pixelCoords + ivec2(x, y), ivec2(0), imageSize - ivec2(1));
                        vec3 nAlbedo = max(imageLoad(gbufferAlbedoImage, nc).rgb, vec3(0.01));
                        vec3 c = imageLoad(inputImage, nc).rgb / nAlbedo;
                        c = min(c, vec3(16.0));

                        m1 += c;
                        m2 += c * c;
                    }
                }

                vec3 mean     = m1 / 9.0;
                vec3 variance = max(vec3(0.0), (m2 / 9.0) - (mean * mean));
                vec3 stddev   = sqrt(variance);

                float clampScale = mix(3.0, 1.5, clamp(motionVectorLen * 20.0, 0.0, 1.0));
                prevAccum.rgb = clamp(prevAccum.rgb, mean - clampScale * stddev, mean + clampScale * stddev);

                vec2 prevMoments = texture(prevMomentsTexture, prevUV).rg;
                float blendAlpha = 1.0 / min(historyLength + 1.0, 128.0);

                accumulatedMoments = mix(prevMoments, currentMoments, blendAlpha);
            }
        }

        historyLength = min(historyLength + 1.0, 128.0);
        float alpha = 1.0 / historyLength;

        currentInputColor.rgb = mix(prevAccum.rgb, currentInputColor.rgb, alpha);
        currentInputColor.a   = historyLength;

        // Save pure irradiance history (demodulated)
        imageStore(accumulationImage, pixelCoords, currentInputColor);

        // Spatial variance estimation for low history lengths
        if (historyLength < 4.0)
        {
            float sumMoments1 = 0.0;
            float sumMoments2 = 0.0;
            float totalWeight = 0.0;

            for (int x = -1; x <= 1; ++x)
            {
                for (int y = -1; y <= 1; ++y)
                {
                    ivec2 nc = clamp(pixelCoords + ivec2(x, y), ivec2(0), imageSize - ivec2(1));
                    vec3 nAlbedo = max(imageLoad(gbufferAlbedoImage, nc).rgb, vec3(0.01));
                    vec3 c = min(imageLoad(inputImage, nc).rgb / nAlbedo, vec3(16.0));
                    float l = getPerceptualLuminance(c);

                    vec4 nND = imageLoad(gbufferNormalImage, nc);
                    vec3 nN  = normalize(nND.rgb * 2.0 - 1.0);
                    float wD = exp(-abs(centerDepth - nND.a) / (0.1 * max(centerDepth, EPSILON)));
                    float wN = pow(max(0.0, dot(centerNormal, nN)), 2.0);
                    float w  = wD * wN;

                    sumMoments1 += l * w;
                    sumMoments2 += (l * l) * w;
                    totalWeight += w;
                }
            }

            filteredVariance = (totalWeight > EPSILON)
                ? max(0.0, (sumMoments2 / totalWeight) - pow(sumMoments1 / totalWeight, 2.0))
                : max(0.01, accumulatedMoments.y - accumulatedMoments.x * accumulatedMoments.x);
        }
        else
        {
            filteredVariance = max(0.0, accumulatedMoments.y - accumulatedMoments.x * accumulatedMoments.x);
        }

        // Higher floor for low history forces higher initial spatial blur around lights
        float minVarianceFloor = (historyLength < 8.0) ? 0.1 : 0.02;
        filteredVariance = max(filteredVariance, minVarianceFloor);

        imageStore(
            currentMomentsImage,
            pixelCoords,
            vec4(accumulatedMoments, filteredVariance, historyLength)
        );

        imageStore(outputImage, pixelCoords, currentInputColor);
        return;
    }
    else
    {
        vec4 momentData  = imageLoad(currentMomentsImage, pixelCoords);
        filteredVariance = momentData.b;
        historyLength    = min(momentData.a, 128.0);
    }

    // STEP 2: À-Trous Wavelet Spatial Filter (Passes 1..N)
    // Matches perceptual log-scale used during moment estimation
    float centerLum = getPerceptualLuminance(currentInputColor.rgb);

    vec3 filteredColor = vec3(0.0);
    float totalWeight  = 0.0;

    const float sigmaDepth = 0.5;
    const float sigmaColor = 4.0; // Scaled for perceptual luminance

    float cappedVariance = min(filteredVariance, 2.0);
    float phiLuminance   = max(0.05, sigmaColor * sqrt(max(1e-4, cappedVariance)));

    const float kernel[3] = float[](0.375, 0.25, 0.0625);

    for (int x = -2; x <= 2; ++x)
    {
        for (int y = -2; y <= 2; ++y)
        {
            ivec2 neighborCoords = clamp(
                pixelCoords + ivec2(x, y) * int(pc.stepSize),
                ivec2(0),
                imageSize - ivec2(1)
            );

            vec3 neighborColor = imageLoad(inputImage, neighborCoords).rgb;
            float neighborLum  = getPerceptualLuminance(neighborColor);

            vec4 neighborND = imageLoad(gbufferNormalImage, neighborCoords);
            vec3 neighborN  = normalize(neighborND.rgb * 2.0 - 1.0);
            float neighborD = neighborND.a;

            float wNormal  = pow(max(0.0, dot(centerNormal, neighborN)), 4.0);
            float wDepth   = exp(-abs(centerDepth - neighborD) / (sigmaDepth * max(centerDepth, EPSILON)));
            float wColor   = exp(-abs(centerLum - neighborLum) / phiLuminance);
            float wSpatial = kernel[abs(x)] * kernel[abs(y)];

            float weight = wNormal * wDepth * wColor * wSpatial;

            filteredColor += neighborColor * weight;
            totalWeight   += weight;
        }
    }

    filteredColor = (totalWeight > EPSILON) ? (filteredColor / totalWeight) : currentInputColor.rgb;

    // Apply albedo modulation exclusively on the last À-Trous pass
    if (pc.isFinalPass == 1)
    {
        filteredColor *= centerAlbedo;

        filteredColor = tonemapReinhard(filteredColor);
    }

    imageStore(
        outputImage,
        pixelCoords,
        vec4(filteredColor, historyLength)
    );
}