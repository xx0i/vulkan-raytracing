#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

struct quad
{
    vec3 origin;
    float pad0; 
    vec3 edgeU;
    float pad1; 
    vec3 edgeV;
    float pad2; 
};

struct aabbObject
{
    uint type;
    uint geoIndex;
    uint matIndex;
    uint _pad0;
};

layout(std430, set = 0, binding = 8) buffer quadBuffer { quad q[]; } quads;
layout(std430, set = 0, binding = 10) buffer aabbObjectsBuffer { aabbObject aabbObj[]; } aabbObjs;

struct attributes
{
    vec2 uv;
};

hitAttributeEXT attributes attribs;

void main()
{
    aabbObject obj = aabbObjs.aabbObj[gl_InstanceCustomIndexEXT];;
    quad q = quads.q[obj.geoIndex];

    vec3 rayOrigin = gl_WorldRayOriginEXT;
    vec3 rayDir    = gl_WorldRayDirectionEXT;

    vec3 n = cross(q.edgeU, q.edgeV);
    float areaSq = dot(n, n);

    if (areaSq < 1e-8) return;

    vec3 normal = n / sqrt(areaSq);
    float denom = dot(rayDir, normal);

    // Reject parallel rays
    if (abs(denom) < 1e-6) return;

    float t = dot(q.origin - rayOrigin, normal) / denom;

    if (t < gl_RayTminEXT || t > gl_RayTmaxEXT) return;

    vec3 p     = rayOrigin + t * rayDir;
    vec3 local = p - q.origin;

    // planar UV projection (handles non-orthogonal edge vectors gracefully)
    vec3 w  = n / areaSq;
    float u = dot(w, cross(local, q.edgeV));
    float v = dot(w, cross(q.edgeU, local));

    // NaN Guard
    if (isnan(u) || isnan(v)) return;

    if (u >= -1e-4 && u <= 1.0 + 1e-4 && v >= -1e-4 && v <= 1.0 + 1e-4)
    {
        attribs.uv = vec2(clamp(u, 0.0, 1.0), clamp(v, 0.0, 1.0));
        reportIntersectionEXT(t, 0);
    }
}